{
  "manifest_version": 3,
  "name": "COOP/COEP Extension Check",
  "version": "0.0.1",
  "description": "Throwaway check: does an extension page report crossOriginIsolated via these manifest keys?",
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "action": {
    "default_popup": "page.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webcontainer-extension-check@stackyard.local"
    }
  }
}
